#!/bin/bash
# vettv_frontend - VetTV MCE Phase 1 user service (Batocera S99userservices).
#
# Replaces EmulationStation with the blank Godot frontend on display :0.
# Batocera is SysV-init, not systemd: user services in
# /userdata/system/services are the supported auto-launch hook (S99).
# Enable with: batocera-services enable vettv_frontend
#
# The Godot binary + .pck are expected in /userdata/vettv/frontend/
# (deployed by scripts/inject-frontend.sh).

APP_DIR="/userdata/vettv/frontend"
APP_BIN="${APP_DIR}/VetTV-MCE.x86_64"
LOG="/userdata/system/logs/vettv-frontend.log"
PIDFILE="/var/run/vettv-frontend.pid"
LOCKFILE="/var/run/vettv-frontend.lock"

log() {
    echo "vettv: $(date '+%H:%M:%S') $*" >> "${LOG}"
}

DISPLAY_NUM=":0"

# X does not always come up on :0 in VMs (a failed first attempt can
# leave the real server on :1). Detect the live socket instead of
# assuming, and remember it for the Godot launch.
wait_for_x() {
    local i s
    for i in $(seq 1 90); do
        for s in /tmp/.X11-unix/X*; do
            if [ -S "$s" ] && pidof openbox >/dev/null; then
                DISPLAY_NUM=":${s##*X}"
                return 0
            fi
        done
        sleep 2
    done
    return 1
}

# ES is launched by emulationstation-standalone in a reboot loop. Remove
# the loop flag first, then keep killing ES until both ES and the
# wrapper are gone: the wrapper spends seconds in display setup between
# ES exits and can relaunch ES after a naive one-shot kill (observed on
# clean reboots), so a short "stays gone" check is not enough.
stop_es() {
    /usr/bin/emulationstation-standalone --stop-rebooting 2>/dev/null
    local i
    for i in $(seq 1 60); do
        if pidof emulationstation >/dev/null; then
            killall emulationstation 2>/dev/null
            sleep 2
        elif ps aux | grep -q '[b]ash /usr/bin/emulationstation-standalone'; then
            sleep 2
        else
            sleep 3
            if ! pidof emulationstation >/dev/null && ! ps aux | grep -q '[b]ash /usr/bin/emulationstation-standalone'; then
                return 0
            fi
        fi
    done
    log "ES did not stay stopped"
    return 1
}

start_frontend() {
    # Serialize concurrent starts (S99 backgrounds services).
    exec 9>"${LOCKFILE}"
    flock -n 9 || return 0
    if [ -f "${PIDFILE}" ]; then
        local oldpid
        oldpid="$(cat "${PIDFILE}")"
        # A zombie still answers kill -0; require a live app cmdline.
        if kill -0 "${oldpid}" 2>/dev/null && grep -q "VetTV-MCE" "/proc/${oldpid}/cmdline" 2>/dev/null; then
            return 0
        fi
    fi
    if [ ! -x "${APP_BIN}" ]; then
        log "${APP_BIN} missing or not executable"
        return 1
    fi
    if ! wait_for_x; then
        # X can lose a DRM-master race with the splash mpv in VMs.
        # Clear the splash player and retry the display stack once.
        log "no X display, clearing splash and restarting S31"
        killall -9 mpv 2>/dev/null
        /etc/init.d/S31emulationstation restart >> "${LOG}" 2>&1
        wait_for_x || { log "still no X display, giving up"; return 1; }
    fi
    stop_es || return 1
    export DISPLAY="${DISPLAY_NUM}"
    export HOME=/userdata/system
    export XDG_RUNTIME_DIR=/var/run
    cd "${APP_DIR}" || return 1
    nohup "${APP_BIN}" --fullscreen --rendering-driver opengl3 >> "${LOG}" 2>&1 &
    echo $! > "${PIDFILE}"
    log "frontend started, pid $(cat "${PIDFILE}")"
}

stop_frontend() {
    [ -f "${PIDFILE}" ] && kill "$(cat "${PIDFILE}")" 2>/dev/null
    rm -f "${PIDFILE}"
}

case "$1" in
    start|"") start_frontend ;;
    stop) stop_frontend ;;
    restart) stop_frontend; start_frontend ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
